-- Clear sounds left behind by a previous execution, then prepare the locally cached MP3s.
local SoundService = game:GetService("SoundService")
for _, oldSound in ipairs(SoundService:GetChildren()) do
if oldSound:IsA("Sound") and oldSound.Name:sub(1, 13) == "KrystalMusic_" then
pcall(function() oldSound:Stop() oldSound:Destroy() end)
end
end

local customAssetGetter
if type(getcustomasset) == "function" then
customAssetGetter = getcustomasset
elseif type(getsynasset) == "function" then
customAssetGetter = getsynasset
end

if customAssetGetter then
for _, musicInfo in ipairs(KRYSTAL_MUSIC_CONFIG) do
local localPath = KRYSTAL_MUSIC_PATHS[musicInfo.dance]
if localPath then
local assetId
local candidates = {localPath, "./" .. localPath}
for _, candidate in ipairs(candidates) do
local assetOk, result = pcall(customAssetGetter, candidate)
if assetOk and type(result) == "string" and result ~= "" then
assetId = result
break
end
end
if assetId then
local sound = Instance.new("Sound")
sound.Name = "KrystalMusic_" .. musicInfo.keyLabel
sound.SoundId = assetId
sound.Volume = S.musicVolume
sound.Looped = true
sound.PlaybackSpeed = 1
sound.Parent = SoundService
S.musicTracks[musicInfo.dance] = sound
end
end
end
end

local stopMusic
stopMusic = function()
for _, sound in pairs(S.musicTracks) do
pcall(function() sound:Stop() end)
end
S.currentMusicDance = nil
end

local function playMusicForEmote(emoteName)
if not S.musicEnabled then
if stopMusic then stopMusic() end
return
end
local sound = S.musicTracks[emoteName]
if not sound then
S.currentMusicDance = nil
return
end
for _, otherSound in pairs(S.musicTracks) do
if otherSound ~= sound then
pcall(function() otherSound:Stop() end)
end
end
pcall(function()
sound:Stop()
sound.TimePosition = 0
sound.Looped = true
sound:Play()
S.currentMusicDance = emoteName
end)
end

local function updateMusicVolume()
for _, sound in pairs(S.musicTracks) do
pcall(function() sound.Volume = S.musicVolume end)
end
end

local KrystalDebris = game:GetService("Debris")
local function makeWeldedMeshPart(partName, meshId, textureId, meshScale, parentPart, targetPart, startCFrame, weldOffset)
    if not parentPart or not targetPart then return nil end
    local part = Instance.new("Part")
    part.Name = partName
    part.Size = Vector3.new(1, 1, 1)
    part.CFrame = startCFrame or targetPart.CFrame
    part.Transparency = 0
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
    part.Anchored = false
    part.Parent = parentPart

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://" .. tostring(meshId)
    mesh.TextureId = "rbxassetid://" .. tostring(textureId)
    mesh.Scale = meshScale
    mesh.Parent = part

    local weld = Instance.new("Weld")
    weld.Name = "KrystalMeshWeld"
    weld.Part0 = part
    weld.Part1 = targetPart
    weld.C0 = weldOffset or CFrame.new()
    weld.C1 = CFrame.new()
    weld.Parent = part
    return part
end


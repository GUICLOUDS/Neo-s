    footer.Position = UDim2.fromOffset(13, 81)
    footer.Size = UDim2.new(1, -26, 0, 20)
    footer.Font = Enum.Font.Gotham
    footer.Text = "Saving tracks to Krystal/"
    footer.TextColor3 = Color3.fromRGB(169, 163, 187)
    footer.TextSize = 10
    footer.TextXAlignment = Enum.TextXAlignment.Left
    footer.Parent = card

    local parented = pcall(function()
        loader.Parent = game:GetService("CoreGui")
    end)
    if not parented or not loader.Parent then
        loader.Parent = playerGui
    end

    local function updateProgress(index, message)
        status.Text = message
        barFill.Size = UDim2.new(math.clamp(index / math.max(total, 1), 0, 1), 0, 1, 0)
        task.wait()
    end

    local function validAudioData(data)
        if type(data) ~= "string" or #data < 1024 then
            return false
        end
        local head = data:sub(1, 256):lower()
        if head:find("<html", 1, true) or head:find("<!doctype", 1, true) or head:find("404: not found", 1, true) then
            return false
        end
        return true
    end

    local function cachedFileIsValid(path)
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return false end
        if type(readfile) == "function" then
            local readOk, data = pcall(readfile, path)
            if not readOk or not validAudioData(data) then return false end
        end
        return true
    end

    local function fetchBytes(url)
        local requestFunction
        if type(request) == "function" then
            requestFunction = request
        elseif type(http_request) == "function" then
            requestFunction = http_request
        elseif type(syn) == "table" and type(syn.request) == "function" then
            requestFunction = syn.request
        end

        if requestFunction then
            local ok, response = pcall(requestFunction, {
                Url = url,
                Method = "GET",
                Headers = { ["User-Agent"] = "Krystal-Music-Loader" },
            })
            if ok and type(response) == "table" then
                local code = tonumber(response.StatusCode or response.StatusCodeValue or response.Status) or 200
                local body = response.Body or response.body
                if code >= 200 and code < 300 and validAudioData(body) then
                    return body
                end
            end
        end

        local ok, body = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and validAudioData(body) then
            return body
        end
        return nil
    end

    if canUseFiles then
        pcall(function()
            if type(isfolder) ~= "function" or not isfolder(folderName) then
                makefolder(folderName)
            end
        end)
    else
        footer.Text = "This executor is missing file APIs; music may be unavailable."
    end

    task.wait(0.15)
    for index, entry in ipairs(KRYSTAL_MUSIC_CONFIG) do
        local path = folderName .. "/" .. entry.file
        updateProgress(index - 1, "Checking " .. index .. "/" .. total .. "  •  " .. entry.file)
        local available = canUseFiles and cachedFileIsValid(path)

        if not available and canUseFiles then
            status.Text = "Downloading " .. index .. "/" .. total .. "  •  " .. entry.file
            task.wait()
            local bytes = fetchBytes(entry.url)
            if bytes then
                local writeOk = pcall(writefile, path, bytes)
                available = writeOk and cachedFileIsValid(path)
            end
        end

        if available then
            KRYSTAL_MUSIC_PATHS[entry.dance] = path
            readyCount = readyCount + 1
        else
            table.insert(failedNames, entry.file)
        end
        updateProgress(index, (available and "Ready " or "Unavailable ") .. index .. "/" .. total .. "  •  " .. entry.file)
    end

    barFill.Size = UDim2.new(1, 0, 1, 0)
    if readyCount == total then
        status.Text = "All music ready — starting dances..."
    else
        status.Text = readyCount .. "/" .. total .. " tracks ready; continuing..."
        footer.Text = "Failed downloads can be retried next execution."
    end
    task.wait(0.75)
    pcall(function() loader:Destroy() end)
end


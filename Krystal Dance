    local loaderName = "KrystalMusicLoader"
    local total = #KRYSTAL_MUSIC_CONFIG
    local readyCount = 0
    local failedNames = {}
    local canUseFiles = type(makefolder) == "function" and type(writefile) == "function" and type(isfile) == "function"

    local oldLoader
    pcall(function()
        oldLoader = game:GetService("CoreGui"):FindFirstChild(loaderName)
        if oldLoader then oldLoader:Destroy() end

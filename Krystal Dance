-- Smooth camera-relative R6 head movement, adapted from the supplied Headmovement.lua.
task.delay(1, function()
    local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

local ANIMATION_ID = "rbxassetid://118838856009328"

local PITCH = { Down = 1.68, Forward = 2.04, Up = 2.31 }
local YAW = { Right = 0.32, Forward = 0.66, Left = 1.00 }

local MAX_YAW = 55
local MAX_PITCH = 40
local YAW_DEADZONE = 3
local PITCH_DEADZONE = 8

local YAW_SMOOTHNESS = 16
local PITCH_SMOOTHNESS = 10

local SWITCH_BIAS = 1.3
local SWITCH_RELEASE = 0.05

local Character
local Humanoid
local Root
local Track

local CurrentX, CurrentY = 0, 0
local DesiredAxis = "X"
local ShownAxis = "X"

local RenderConnection
local CharacterConnection

local function Cleanup()
    if RenderConnection then
        RenderConnection:Disconnect()
        RenderConnection = nil
    end

    if CharacterConnection then
        CharacterConnection:Disconnect()
        CharacterConnection = nil
    end

    if Track then
        Track:Stop(0)
        Track:Destroy()
        Track = nil
    end
end

local function Amount(angle, maximum, deadzone)
    local magnitude = math.abs(angle)

    if magnitude <= deadzone then
        return 0
    end

    return math.clamp((magnitude - deadzone) / (maximum - deadzone), 0, 1)
end

local function Ease(t)
    return 1 - (1 - t) * (1 - t)
end

local function SetupCharacter(char)
    Cleanup()

    Character = char
    Humanoid = char:WaitForChild("Humanoid")

    if Humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        return
    end

    Root = char:WaitForChild("HumanoidRootPart")

    local Animator = Humanoid:FindFirstChildOfClass("Animator")
        or Instance.new("Animator", Humanoid)

    local Animation = Instance.new("Animation")
    Animation.AnimationId = ANIMATION_ID

    local Success, Result = pcall(function()
        return Animator:LoadAnimation(Animation)
    end)

    Animation:Destroy()

    if not Success then
        warn("Animation failed to load:", Result)
        return
    end

    Track = Result
    Track.Priority = Enum.AnimationPriority.Action4
    Track.Looped = true
    Track:Play(0, 1, 0)
    Track:AdjustSpeed(0)

    CurrentX, CurrentY = 0, 0
    DesiredAxis, ShownAxis = "X", "X"
    Track.TimePosition = PITCH.Forward

    RenderConnection = RunService.RenderStepped:Connect(function(dt)
        if not Track or not Track.IsPlaying then
            return
        end

        if not Character or not Character.Parent
            or not Root or not Root.Parent then
            return
        end

        local Camera = workspace.CurrentCamera
        if not Camera then
            return
        end

        local Look = Camera.CFrame.LookVector

        local Yaw = math.deg(math.atan2(
            Look:Dot(Root.CFrame.RightVector),
            Look:Dot(Root.CFrame.LookVector)
        ))
        local Pitch = math.deg(math.asin(math.clamp(Look.Y, -1, 1)))

        Yaw = math.clamp(Yaw, -MAX_YAW, MAX_YAW)
        Pitch = math.clamp(Pitch, -MAX_PITCH, MAX_PITCH)

        local RawX = Amount(Yaw, MAX_YAW, YAW_DEADZONE)
        local RawY = Amount(Pitch, MAX_PITCH, PITCH_DEADZONE)

        if DesiredAxis == "X" and RawY > RawX * SWITCH_BIAS and RawY > 0 then
            DesiredAxis = "Y"
        elseif DesiredAxis == "Y" and RawX * SWITCH_BIAS > RawY then
            DesiredAxis = "X"
        end

        local TargetX = (DesiredAxis == "X") and RawX * (Yaw >= 0 and 1 or -1) or 0
        local TargetY = (DesiredAxis == "Y") and RawY * (Pitch >= 0 and 1 or -1) or 0

        local AlphaX = 1 - math.exp(-YAW_SMOOTHNESS * dt)
        local AlphaY = 1 - math.exp(-PITCH_SMOOTHNESS * dt)

        CurrentX += (TargetX - CurrentX) * AlphaX
        CurrentY += (TargetY - CurrentY) * AlphaY

        if ShownAxis ~= DesiredAxis then
            local ShownValue = (ShownAxis == "X") and math.abs(CurrentX) or math.abs(CurrentY)
            if ShownValue < SWITCH_RELEASE then
                ShownAxis = DesiredAxis
            end
        end

        local Time = PITCH.Forward

        if ShownAxis == "Y" then
            local e = Ease(math.abs(CurrentY))
            if CurrentY >= 0 then
                Time = PITCH.Forward + e * (PITCH.Up - PITCH.Forward)
            else
                Time = PITCH.Forward + e * (PITCH.Down - PITCH.Forward)
            end
        else
            local e = Ease(math.abs(CurrentX))
            if CurrentX >= 0 then
                Time = YAW.Forward + e * (YAW.Right - YAW.Forward)
            else
                Time = YAW.Forward + e * (YAW.Left - YAW.Forward)
            end
        end

        Track:AdjustSpeed(0)
        Track.TimePosition = Time
    end)

    CharacterConnection = Humanoid.Died:Connect(Cleanup)
end

Player.CharacterAdded:Connect(SetupCharacter)
Player.CharacterRemoving:Connect(Cleanup)

if Player.Character then
    SetupCharacter(Player.Character)
end
end)

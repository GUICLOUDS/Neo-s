local function createMoneyLauncherAndShoot()
    local clone = S.clone
    local torso = clone and clone:FindFirstChild("Torso")
    local leftArm = clone and clone:FindFirstChild("Left Arm")
    if not torso then
        warn("Krystal Dance: Money launcher could not find the visible R6 torso.")
        return
    end

    removeMoneyLauncher()
    local attachTo = leftArm or torso
    local initialCFrame = attachTo.CFrame * CFrame.new(0, -0.25, -0.55) * CFrame.Angles(math.rad(-90), 0, 0)
    local weldOffset = initialCFrame:Inverse() * attachTo.CFrame
    S.moneyLauncher = makeWeldedMeshPart(
        "KrystalMoneyLauncher", 1285245, 8587344, Vector3.new(0.85, 0.85, 0.85),
        attachTo, attachTo, initialCFrame, weldOffset
    )
    if S.moneyLauncher then
        S.moneyLauncher.CanCollide = false
        S.moneyLauncher.CanTouch = false
        S.moneyLauncher.CanQuery = false
        S.moneyLauncher.Massless = true
    end
    if not S.moneyLauncher then return end

    S.moneyProjectileTask = task.spawn(function()
        while S.isMoney and S.moneyLauncher and S.moneyLauncher.Parent do
            local launcher = S.moneyLauncher
            local projectile = Instance.new("Part")
            projectile.Name = "KrystalMoneyProjectile"
            projectile.Size = Vector3.new(1, 1, 1)
            local visibleRoot = clone and clone:FindFirstChild("HumanoidRootPart")
            local shootDirection = (visibleRoot and visibleRoot.CFrame.LookVector) or launcher.CFrame.LookVector
            if shootDirection.Magnitude < 0.001 then
                shootDirection = Vector3.new(0, 0, -1)
            else
                shootDirection = shootDirection.Unit
            end
            local spawnPosition = launcher.Position + shootDirection * 0.8
            projectile.CFrame = CFrame.lookAt(spawnPosition, spawnPosition + shootDirection)
            projectile.Anchored = false
            projectile.CanCollide = true
            projectile.CanTouch = true
            projectile.CanQuery = true
            projectile.Massless = false
            pcall(function() projectile.CollisionGroup = S.MONEY_PROJECTILE_GROUP end)
            projectile.Parent = workspace

            local moneyMesh = Instance.new("SpecialMesh")
            moneyMesh.MeshType = Enum.MeshType.FileMesh
            moneyMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
            moneyMesh.MeshId = "rbxassetid://667285348"
            moneyMesh.TextureId = "rbxassetid://665939136"
            moneyMesh.Parent = projectile

            local velocity = Instance.new("BodyVelocity")
            velocity.Name = "KrystalMoneyLaunchVelocity"
            velocity.MaxForce = Vector3.new(99999, 99999, 99999)
            velocity.Velocity = shootDirection * 45
            velocity.Parent = projectile
            KrystalDebris:AddItem(velocity, 0.1)
            KrystalDebris:AddItem(projectile, 4)

            task.wait(0.35)
        end
        S.moneyProjectileTask = nil
    end)
end

